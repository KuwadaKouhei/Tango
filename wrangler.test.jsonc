{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tango-test",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // Startの仮想module `@tanstack/react-start/server-entry` は
  // vitest-pool-workers の静的解析で解決できないため、dispatch検証用の実ファイルを使う。
  "main": "tests/workers/dispatch-worker.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tango-test",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://tango.test",
    "BETTER_AUTH_SECRET": "test-better-auth-secret-32chars!!",
    "GOOGLE_CLIENT_ID": "test-google-client-id",
    "GOOGLE_CLIENT_SECRET": "test-google-client-secret",
  },
}
