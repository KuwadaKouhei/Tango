{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tango",
  // T01 PoC実施日。更新は compatibility test 付きPRで行う。
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tango",
      "database_id": "9f3a05f9-df97-4df5-9bcb-61e8c272c229",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://tango.eitango.workers.dev",
  },
}
