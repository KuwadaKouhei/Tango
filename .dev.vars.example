# Copy to `.dev.vars`. Real secrets must never be committed.
# Google Cloud Console の Authorized redirect URI 例:
#   http://localhost:3000/api/auth/callback/google
# 値はチャットやGitへ貼らない。
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
# DeepL API Free。値はチャットやGitへ貼らない。
# https://www.deepl.com/your-account/keys
DEEPL_AUTH_KEY=replace-me
# Playwright E2E を localhost で回すときだけ設定する。本番 Worker には置かない。
# E2E_AUTH_SECRET=replace-me-e2e-only
