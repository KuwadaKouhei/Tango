{
  "name": "tango",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "auth generate --config src/infrastructure/auth/better-auth.cli.ts --output src/infrastructure/db/schema/auth.generated.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tango --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.32",
    "@types/node": "22.20.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "auth": "1.7.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
